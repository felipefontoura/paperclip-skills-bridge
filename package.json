{
  "name": "@felipefontoura/paperclip-skills-bridge",
  "version": "0.1.0",
  "description": "Stateless HTTP bridge that translates the Paperclip skills API into the .well-known/skills protocol.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "paperclip-skills-bridge": "./dist/server.js"
  },
  "files": [
    "dist",
    "Dockerfile",
    "docker-compose.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "start": "node ./dist/server.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run clean && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "paperclip",
    "hermes",
    "hermes-agent",
    "well-known-skills",
    "skills-bridge"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/felipefontoura/paperclip-skills-bridge"
  }
}
